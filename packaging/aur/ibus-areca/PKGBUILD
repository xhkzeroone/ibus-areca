pkgname=ibus-areca
pkgver=0.1.3
pkgrel=1
pkgdesc='Areca Vietnamese input method for IBus using the Bamboo engine'
arch=('x86_64')
url='https://github.com/xhkzeroone/ibus-areca'
license=('MIT')
depends=(
  'ibus'
  'glib2'
  'libxkbcommon'
  'gtk4'
  'python'
  'python-gobject'
  'gdk-pixbuf2'
  'libinput'
  'libei'
  'libportal'
  'systemd-libs'
  'dbus'
)
makedepends=(
  'cmake'
  'git'
  'go'
  'ninja'
  'pkgconf'
)
provides=("$pkgname")
conflicts=("$pkgname-bin" "$pkgname-git")
_bamboo_commit='b2e49a2b48c7d3772a3673142a7747eccd9d5f79'
source=(
  "${pkgname}::git+${url}.git#tag=v${pkgver}"
  "bamboo-core::git+https://github.com/BambooEngine/bamboo-core.git#commit=${_bamboo_commit}"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  git -C "${srcdir}/${pkgname}" submodule init
  git -C "${srcdir}/${pkgname}" config \
    submodule.bamboo/bamboo-core.url "${srcdir}/bamboo-core"
  git -C "${srcdir}/${pkgname}" -c protocol.file.allow=always \
    submodule update
}

build() {
  export CXXFLAGS+=" -ffile-prefix-map=${srcdir}=."
  export GOFLAGS="${GOFLAGS:-} -trimpath"
  cmake -S "${srcdir}/${pkgname}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib/ibus \
    -DBUILD_TESTING=ON
  cmake --build build --parallel
  test -x build/ibus-engine-areca
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build --strip
  install -Dm644 "${srcdir}/${pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/${pkgname}/bamboo/bamboo-core/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.bamboo-core"
}
